{
  "cli": {
    "version": ">= 12.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_ENV": "development"
      }
    },
    "staging": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "APP_ENV": "staging",
        "EXPO_PUBLIC_API_URL": "https://d10kr0wsoouzco.cloudfront.net/api",
        "EXPO_PUBLIC_CDN_BASE_URL": "https://devnagrifarms-staging-uploads-16wvjo.s3.ap-south-1.amazonaws.com"
      }
    },
    "production": {
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://api.devnagrifarms.com/api",
        "EXPO_PUBLIC_CDN_BASE_URL": "https://cdn.devnagrifarms.com"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
